# Copy to .env and fill in. Never commit .env.
AICREDIT_API_KEY=your_project_api_key_here
AICREDIT_BASE_URL=https://aicreditapi.com/api/v1
PORT=3000

# Credit economics: 1 credit = CREDIT_USD of retail value.
# Users are charged the AICredit price plus MARGIN_PCT percent. A model whose price with the margin would go
# above its official price is charged at the AICredit price, with no margin.
# AICREDIT_MASTER_DISCOUNT_PCT is the extra discount AICredit gives this account; it only changes the cost
# and margin shown in the admin console, never what users pay.
CREDIT_USD=0.001
MARGIN_PCT=5
AICREDIT_MASTER_DISCOUNT_PCT=5
SIGNUP_BONUS_CREDITS=1000

# Payments. With no Stripe key, purchases run in demo mode (credits granted instantly, no charge).
# Use the test mode key (sk_test_...) until you are ready to take real money.
STRIPE_SECRET_KEY=
# Optional: lets Stripe tell the app about payments at once (renewals, failed cards). Without it the app checks
# Stripe itself after checkout, when the billing page opens, and every 30 minutes.
# Webhook address: <PUBLIC_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: use prices you made in the Stripe dashboard. Left empty, the app makes the monthly prices itself.
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_MAX5=
# STRIPE_PRICE_MAX20=
PUBLIC_URL=http://localhost:3000

# Comma-separated emails that can see the admin dashboard.
ADMIN_EMAILS=

# Contact email shown on the Terms of Use and Privacy Policy pages
SUPPORT_EMAIL=           # for example support@scenly.ai

# Sign in with Google. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this redirect address to it:
#   <PUBLIC_URL>/api/auth/google/callback   (locally: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (sign-up confirmation + code, welcome, password reset, receipts, low / out of credits, plan changes).
# Main sender: Mandrill (Mailchimp Transactional). Paste the API key from mandrillapp.com > Settings > API keys.
# The sending domain scenly.ai must be verified in Mandrill (SPF + DKIM records) before mail is delivered.
MANDRILL_API_KEY=
MAIL_FROM=Scenly <no-reply@scenly.ai>
MAIL_REPLY_TO=info@adxl.ai
# Warn by email when a balance falls under this many credits (sent once until the next top-up).
LOW_CREDIT_ALERT=1000
# Credit rules: top-up packs valid this many days; hours plan credits wait for a late renewal;
# days paid credits from before the rules stay valid after the switch (empty = 90, 0 = no expiry).
PACK_VALID_DAYS=90
SUB_CREDIT_GRACE_HOURS=6
CARRY_CREDIT_DAYS=
# Optional SMTP fallback, used only when Mandrill fails (or on its own if there is no Mandrill key).
# With no mail service at all, new accounts work straight away without a confirmation email,
# and "Forgot password?" shows the reset link on screen (local use only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Design Library: how many styles in each category a free account can use (0 locks the whole library).
STYLE_FREE_PER_CATEGORY=2

# ---------- Storage, downloads and background jobs ----------
# Files are kept on this computer under DATA_DIR/storage. Limits are in MB.
# MAX_IMAGE_UPLOAD_MB=30
# MAX_VIDEO_UPLOAD_MB=500
# MAX_AUDIO_UPLOAD_MB=100
# MAX_UPLOAD_MB=100
# Storage each account may use, in MB. 0 = no limit.
# STORAGE_QUOTA_MB=0
# Remove generated files older than this many days. 0 = keep forever.
# RETENTION_DAYS=0
# How long a download link works, in seconds.
# DOWNLOAD_LINK_SECONDS=3600
# Secret used to sign download links. Set your own long random text at production.
# LINK_SECRET=
# Background jobs running at once: for the whole app, and for one account.
# JOBS_MAX_GLOBAL=4
# JOBS_MAX_PER_USER=2
# Longest video clip the app offers, in seconds.
# VIDEO_MAX_SECONDS=15
# ffmpeg is found on its own. Set these only if it lives somewhere unusual, or FFMPEG_OFF=1 to switch video tools off.
# FFMPEG_PATH=
# FFPROBE_PATH=
# FFMPEG_OFF=

# ---------- Feature switches (all off until each part is finished and tested) ----------
# FEATURE_VIDEO_BUILDER=
# FEATURE_VIDEO_AGENT=
# FEATURE_PRECISION_EDIT=
# FEATURE_MUSIC_LIBRARY=
# FEATURE_BEAT_SYNC=
# FEATURE_AUDIO_FIRST=
# FEATURE_VIDEO_EXTEND=
# FEATURE_FRAME_TILES=
# Studio Pro: a second image + video studio beside the Image, Video, Video Agent and Video Builder pages (server/pro.js).
# FEATURE_STUDIO_PRO=1
# PRO_PLAN_MODEL=gpt-5.6-luna,gemini-3.1-flash-lite,deepseek-v4-flash   (chat models that write the agent's plan, fastest first)
# PRO_IMAGE_MODEL=seedream-5.0-pro,nano-banana,nano-banana-2,gpt-image-2  (picture models, in the order they are tried)
# PRO_FRAME_MODEL=seedream-5.0-pro,gpt-image-2                             (picture models that return a web link, for video start frames)
# Monthly plans with Stripe: free trial, upgrade prompt when credits run out, change or cancel plan, Stripe billing page.
# FEATURE_SUBSCRIPTIONS=

# ---------- Production (one server behind Cloudflare) ----------
# NODE_ENV=production turns on secure cookies, security checks and the settings check printed at start.
# NODE_ENV=production
# PUBLIC_URL=https://scenly.ai
# LINK_SECRET=  (long random text, 32+ characters: run `openssl rand -hex 32`)
# The visitor's real address comes from Cloudflare's CF-Connecting-IP header (used for sign-in limits).
# TRUST_CLOUDFLARE=1
# Proxies in front of the app to trust for https and addresses. Default in production: private networks (Coolify/Docker).
# TRUST_PROXY=
# Set to 0 to switch off the sign-in and sign-up attempt limits.
# RATE_LIMITS=1

# ---------- Cloudflare R2 (file copies, downloads and database backups) ----------
# With these set, every stored file is also copied to the bucket, downloads and media are served straight from it,
# and the database is backed up there every hour. Leave empty to keep files on this server only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Another S3-compatible store instead of R2: S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_BUCKET
# Optional folder inside the bucket (for example to share one bucket between test and live).
# BUCKET_PREFIX=
# 0 = the server sends files itself even when the bucket has them.
# BUCKET_SERVE=1
# How often to look for files not yet copied, in minutes.
# BUCKET_SWEEP_MINUTES=10
# Database backups: how often (hours; default 1 with a bucket, 24 without) and how many daily copies to keep.
# BACKUP_EVERY_HOURS=1
# BACKUP_KEEP_DAYS=30
# BACKUPS=1
